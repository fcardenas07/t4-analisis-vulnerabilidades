{
    "name": "Python Ciberseguridad Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.formatting.provider": "black",
                "editor.formatOnSave": true,
                "notebook.formatOnSave.enabled": true,
                "jupyter.notebook.defaultKernel": "Python (ciberseguridad)",
                "jupyter.kernels.filter": [
                    {
                        "name": "ciberseguridad"
                    }
                ]
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "uv sync --no-install-project && uv run python -m ipykernel install --user --name ciberseguridad --display-name 'Python (ciberseguridad)' && codeql pack download codeql/python-queries && codeql pack download codeql/javascript-queries && codeql pack download codeql/java-queries && grype db update || true",
    "remoteUser": "vscode",
    "runArgs": [
        "--name",
        "ciberseguridad-t3-dev-container"
    ]
}